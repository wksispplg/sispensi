# ------------------------------------------------------------------
# Supabase — ambil dari dashboard Supabase: Project Settings > API
# ------------------------------------------------------------------

# URL project Supabase (boleh diekspos ke client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (boleh diekspos ke client, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-ONLY. JANGAN pernah diekspos ke client.
# Dipakai untuk operasi admin & Edge Function (mis. eskalasi otomatis).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# (Opsional) URL publik aplikasi — dipakai untuk QR verifikasi pada PDF surat.
# Bila kosong, otomatis memakai origin dari request.
NEXT_PUBLIC_APP_URL=
